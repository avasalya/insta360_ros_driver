<?xml version="1.0"?>
<launch>
    <arg name="equirectangular" default="true"/>
    <arg name="perspective" default="false"/>
    <arg name="imu_filter" default="false"/>

    <!-- 1. Default fallback baseline if everything is disabled -->
    <let name="view_topic" value="/dual_fisheye/image"/>
    <!-- 2. Overwrite with equirectangular if enabled -->
    <let if="$(var equirectangular)" name="view_topic" value="/equirectangular/image"/>
    <!-- 3. Final priority override: perspective always takes precedence if true -->
    <let if="$(var perspective)" name="view_topic" value="/perspective/image"/>

    <arg name="equirectangular_config" default="$(find-pkg-share insta360_ros_driver)/config/equirectangular.yaml"/>
    <arg name="perspective_config" default="$(find-pkg-share insta360_ros_driver)/config/perspective.yaml"/>
    <arg name="imu_config" default="$(find-pkg-share insta360_ros_driver)/config/imu_filter.yaml"/>

   <!-- Publishes Compressed Images -->
    <node pkg="insta360_ros_driver" exec="insta360_ros_driver" name="insta360_ros_driver" output="screen">
        <!-- Main Streaming Resolution Option -->
        <param name="video_resolution" value="RES_1152_1152P30"/>

        <!-- Low Resolution Video (LRV) Preview Stream Option -->
        <param name="lrv_video_resolution" value="RES_1440_720P30"/>
    </node>

    <!-- Decodes Compressed Images -->
    <node pkg="insta360_ros_driver" exec="decoder" name="image_decoder" output="log">
        <param name="compressed_topic" value="/dual_fisheye/image/compressed"/>
        <param name="uncompressed_topic" value="/dual_fisheye/image"/>
        <param name="skip_frame" value="2"/>
        <!-- If you want to minimize the CPU load the most, you can decode only the i-frames. But the expected FPS is about 1-2 FPS -->
        <param name="i_frame_only" value="false"/>
        <param name="decoder_name" value="h264_cuvid"/>
        <!-- possile decoder h264_cuvid, h264, hevc?, mjpeg? -->
    </node>

    <!-- Creates Equirectangular Images -->
    <node if="$(var equirectangular)" pkg="insta360_ros_driver" exec="equirectangular_cpp" name="equirectangular_node" output="screen">
        <param from="$(var equirectangular_config)" />
    </node>
    <!-- Creates Perspective Images -->
    <node if="$(var perspective)" pkg="insta360_ros_driver" exec="perspective_cpp" name="perspective_node" output="screen">
        <param from="$(var perspective_config)" />
    </node>
    <!-- Applies a Madgwick Filter to the 6-DOF IMU to get Orientation -->
    <node if="$(var imu_filter)" pkg="imu_filter_madgwick" exec="imu_filter_madgwick_node" name="imu_filter" output="log">
        <param from="$(var imu_config)"/>
    </node>
    <!-- Automatically open a GUI window to visualize the perspective video stream -->
    <node pkg="image_view" exec="image_view" name="live_viewer" output="screen">
        <remap from="image" to="$(var view_topic)"/>
        <!-- <remap from="image" to="/perspective/image"/> -->
        <!-- <remap from="image" to="/dual_fisheye/image"/> -->
        <!-- <remap from="image" to="/equirectangular/image"/> -->
    <!-- Dynamic Topic Selection: Evaluates fallback logic automatically -->

    </node>

</launch>
